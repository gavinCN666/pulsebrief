# ---------------------------------------------------------------------------
# PulseBrief model provider configuration
# Copy this file to `.env` and fill in your own credentials.
# NEVER commit `.env` or a real API key.
# ---------------------------------------------------------------------------

# `mock` runs a deterministic offline planner (no API key needed, used by the
# demo and the evaluation suite). Set to `openai` for any OpenAI-compatible
# chat-completions endpoint, e.g. DeepSeek.
LLM_PROVIDER=mock

# Used when LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-me
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Harness execution limits
# ---------------------------------------------------------------------------
HARNESS_MAX_STEPS=12
HARNESS_MAX_TOOL_RETRIES=1
HARNESS_TOOL_TIMEOUT_SECONDS=10
HARNESS_MAX_CONCURRENT_RUNS=1
HARNESS_MAX_TOOL_CALLS=24
HARNESS_MAX_IDENTICAL_TOOL_CALLS=2
HARNESS_MAX_RUN_SECONDS=180
HARNESS_APPROVAL_TTL_MINUTES=30
HARNESS_RECENT_TOOL_RESULTS=5
HARNESS_MAX_CONTEXT_CHARS=14000
HARNESS_MIN_ANALYSIS_DAYS=14

# Optional: override the SQLite location
# PULSEBRIEF_DB=./pulsebrief.db
