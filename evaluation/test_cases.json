{
  "version": 1,
  "min_days": 14,
  "cases": [
    {
      "id": "normal_clean_30d",
      "category": "Normal Case",
      "description": "30 天干净数据，完整走完分析、计划、审批、写库、验证。",
      "user_request": "帮我分析最近一个月的健康状态，看看睡眠和运动有哪些值得注意的变化，并给我制定下一周的改善计划。",
      "dataset": "clean_30d",
      "action": "approve",
      "expect": {
        "status": "COMPLETED",
        "tools_used": ["inspect_dataset", "detect_trends", "get_user_profile", "validate_action_plan", "create_action_tasks"],
        "tools_forbidden": ["query_health_metrics"],
        "dataset_valid": true,
        "dataset_analysis_ready": true,
        "tasks": 4,
        "verification_ok": true,
        "approval_required": true,
        "final_contains": ["任务 ID", "校验", "睡眠"],
        "final_not_contains": ["无法确认", "也许大概"],
        "metric_checks": [
          {"metric": "sleep_hours", "tolerance": 0.02},
          {"metric": "steps", "tolerance": 2.0}
        ]
      }
    },
    {
      "id": "normal_clean_35d",
